{
  "schemaVersion": 1,
  "authors": [
    "Mystery2099"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/wooden-accents-mod",
    "sources": "https://github.com/The-Mystora-Project/WoodenAccentsMod",
    "issues": "https://github.com/The-Mystora-Project/WoodenAccentsMod/issues"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=1.21.1 <1.21.2",
    "java": ">=21",
    "fabric-api": ">=0.116.17+1.21.1",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "voxlib": ">=1.8.0+1.21.1"
  },
  "description": "Vanilla-scale furniture and structural accents for every wood type.",
  "entrypoints": {
    "main": [
      {
        "value": "com.github.mystery2099.woodenAccentsMod.WoodenAccentsFabric",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "com.github.mystery2099.woodenAccentsMod.WoodenAccentsModClient",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "com.github.mystery2099.woodenAccentsMod.data.generation.ModDataGenerator",
        "adapter": "kotlin"
      }
    ],
    "jei_mod_plugin": [
      "com.github.mystery2099.woodenAccentsMod.jei.WoodenAccentsJeiPlugin"
    ],
    "rei_client": [
      "com.github.mystery2099.woodenAccentsMod.rei.WoodenAccentsReiPlugin"
    ],
    "shulkerboxtooltip": [
      {
        "value": "com.github.mystery2099.woodenAccentsMod.shulkerBoxTooltip.ShulkerBoxTooltipPlugin",
        "adapter": "kotlin"
      }
    ]
  },
  "environment": "*",
  "mixins": [
    {
      "config": "wooden_accents_mod.client.mixins.json",
      "environment": "client"
    }
  ],
  "icon": "assets/wooden_accents_mod/icon.png",
  "id": "wooden_accents_mod",
  "license": "MMPL-1.0.1",
  "name": "Wooden Accents Mod",
  "suggests": {
    "easyshulkerboxes": "21.*.*",
    "jei": "19.*.*",
    "roughlyenoughitems": "16.*.*",
    "shulkerboxtooltip": ">=5.1.9+1.21.1"
  },
  "version": "${version}",
  "accessWidener": "wooden_accents_mod.accesswidener"
}